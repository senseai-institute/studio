# SenseAI Studio settings. Names match the viewer runner's, so one env file serves both.

# The species library, profile specs and research requests (a profiles checkout). Required.
SENSEAI_PROFILES_REPO=~/senseai/profiles
# Folder with the other checkouts side by side (bench, world, circuits …). Default ~/senseai.
SENSEAI_STACK_DIR=~/senseai
# Recordings: DSEC sequence folders (event + frame) and .wav files. Optional.
SENSEAI_DATA_ROOT=/data/dsec
# The bench CLI and the stack's Python (probes for bench arms and checkpoint metadata).
SENSEAI_BENCH_CMD=senseai-bench
SENSEAI_BENCH_PYTHON=
# A trained world checkpoint and the tokens.yaml it was trained with (enables learned arms).
SENSEAI_WORLD_CKPT=
SENSEAI_TOKENS_YAML=
# A world checkout when it is not at $SENSEAI_STACK_DIR/world; a folder of more checkpoints.
SENSEAI_WORLD_REPO=
SENSEAI_ARTEFACTS=
# The circuits CLI (shows "circuits: not installed" when absent).
SENSEAI_CIRCUITS_CMD=senseai-circuits
# The research backend (senseai-institute/research): the Research tab appears only when set.
# Studio proxies /api/studio/research/* to RESEARCH_URL/api/research/*.
# Locally http://127.0.0.1:8100; on Railway http://${{research.RAILWAY_PRIVATE_DOMAIN}}:8100
RESEARCH_URL=
# The same random string as on the research service (openssl rand -hex 32). Required when the
# research service is not on this machine.
RESEARCH_PROXY_TOKEN=
# Founder content (modalities, pipeline steps, use cases). Default: this repo's content/.
STUDIO_CONTENT=
# Where run jobs are kept. Default ./data
STUDIO_DATA=./data
# Shared password (user name is free; it is forwarded to research as X-SenseAI-User).
VIEWER_PASSWORD=
# Railway only: clone the profiles repo at start when no checkout is mounted.
SENSEAI_PROFILES_GIT=
SENSEAI_PROFILES_REF=
GITHUB_TOKEN=
# Port (default 8200).
STUDIO_PORT=8200
