# SenseAI Studio settings (environment variables; on Railway, the service's Variables tab).

# The research backend (senseai-institute/research). Studio proxies /api/studio/research/* to
# RESEARCH_URL/api/research/*. On Railway: http://${{research.RAILWAY_PRIVATE_DOMAIN}}:8100
RESEARCH_URL=
# The same random string as on the research service (openssl rand -hex 32). Required when the
# research service is not on this machine.
RESEARCH_PROXY_TOKEN=

# The password people sign in with (HTTP Basic; the user name is what research records on
# every approval). Required on Railway.
VIEWER_PASSWORD=

# The SenseAI checkouts Studio reads (read-only).
SENSEAI_STACK_DIR=
SENSEAI_PROFILES_REPO=
SENSEAI_WORLD_REPO=
SENSEAI_DATA_ROOT=
SENSEAI_BENCH_CMD=senseai-bench
SENSEAI_BENCH_PYTHON=
SENSEAI_WORLD_CKPT=
SENSEAI_TOKENS_YAML=
SENSEAI_ARTEFACTS=
SENSEAI_CIRCUITS_CMD=senseai-circuits

STUDIO_CONTENT=
STUDIO_DATA=
STUDIO_PORT=8200
